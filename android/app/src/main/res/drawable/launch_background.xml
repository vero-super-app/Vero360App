<?xml version="1.0" encoding="utf-8"?>
<!-- Branded native splash — matches Flutter VeroLaunchSplash.
     Use the PNG foreground, not @mipmap/ic_launcher. On API 26+ the mipmap
     is an adaptive-icon XML, and resource shrinking then drops android:src,
     which crashes at launch with "bitmap requires a valid src attribute". -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/vero_splash_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
