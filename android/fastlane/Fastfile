# frozen_string_literal: true

# Fastlane for Play Store uploads (Flutter AAB).
# From repo root:  .\tool\play_deploy.ps1
# From android/:   bundle exec fastlane internal
#
# Prerequisites:
#   1. android/key.properties + upload keystore
#   2. android/play-store-service-account.json (Play Console API access)
#   3. Play app com.vero265.app (upload cert must match this keystore)

default_platform(:android)
opt_out_usage

def project_root
  File.expand_path('../..', __dir__)
end

def release_aab
  File.join(project_root, 'build/app/outputs/bundle/release/app-release.aab')
end

def require_play_json!
  path = ENV['PLAY_STORE_JSON_KEY']
  path = File.expand_path('../play-store-service-account.json', __dir__) if path.nil? || path.empty?
  return path if File.exist?(path)

  UI.user_error!(<<~MSG)
    Missing Play API key at:
      #{path}

    Create it:
      1. Google Cloud Console → APIs → enable "Google Play Android Developer API"
      2. Create a service account → Keys → Add key → JSON
      3. Play Console → Setup → API access → link that Cloud project
      4. Invite the service account with "Release to production, exclude devices…" (or Admin)
      5. Save the JSON as android/play-store-service-account.json
  MSG
end

def upload_aab!(track)
  require_play_json!
  aab = release_aab
  UI.user_error!("AAB not found at #{aab}. Run fastlane build first.") unless File.exist?(aab)

  upload_to_play_store(
    track: track,
    aab: aab,
    release_status: track == 'production' ? 'draft' : 'completed',
    skip_upload_metadata: true,
    skip_upload_changelogs: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_apk: true
  )
end

platform :android do
  desc 'Check Ruby/Fastlane/signing/Play JSON without uploading'
  lane :verify do
    UI.success("Ruby #{RUBY_VERSION}")
    UI.message("Project: #{project_root}")
    key_props = File.expand_path('../key.properties', __dir__)
    UI.user_error!("Missing #{key_props}") unless File.exist?(key_props)
    UI.success('key.properties present')
    json = require_play_json!
    UI.success("Play JSON: #{json}")
    UI.success('Fastlane is ready. Run: .\\tool\\play_deploy.ps1')
  end

  desc 'Bump pubspec build number (+N) by 1'
  lane :bump_build do
    Dir.chdir(project_root) do
      sh('dart run tool/bump_build.dart')
    end
  end

  desc 'Build release app bundle (signed)'
  lane :build do
    Dir.chdir(project_root) do
      sh('flutter pub get')
      sh('flutter build appbundle --release --android-skip-build-dependency-validation')
    end
  end

  desc 'Upload existing AAB to a track (ENV TRACK=internal|alpha|production)'
  lane :upload do
    track = (ENV['TRACK'] || 'internal').downcase
    upload_aab!(track)
  end

  desc 'Upload existing AAB to Play internal testing track'
  lane :upload_internal do
    ENV['TRACK'] = 'internal'
    upload
  end

  desc 'Build + upload to Play internal testing'
  lane :internal do
    build
    upload_internal
  end

  desc 'Build + upload to Play production (draft — review in Console)'
  lane :production do
    build
    upload_aab!('production')
  end

  desc 'Build + upload to closed beta (alpha track)'
  lane :beta do
    build
    upload_aab!('alpha')
  end
end
