rules_version = '2';

// Deploy in Firebase Console → Firestore → Rules (pick the SAME database your app uses:
// "(default)" or "verodb"). Or: firebase deploy --only firestore:rules
//
// App writes marketplace_items with merchantId = Firebase Auth UID.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMarketplaceOwner(data) {
      return isSignedIn() && (
        data.merchantId == request.auth.uid ||
        data.sellerUserId == request.auth.uid
      );
    }

    function isOwnerUid(data) {
      return isSignedIn() && (
        data.merchantId == request.auth.uid ||
        data.sellerUserId == request.auth.uid ||
        data.ownerId == request.auth.uid ||
        data.userId == request.auth.uid ||
        data.hostUid == request.auth.uid
      );
    }

    // Clients may leave review as-is or send back to pending — never self-approve.
    function reviewStatusClientOk() {
      let next = request.resource.data.get('reviewStatus', '');
      let prev = resource.data.get('reviewStatus', '');
      return next == prev
        || next == 'pending'
        || next == '';
    }

    function createReviewNotApproved() {
      let rs = request.resource.data.get('reviewStatus', 'pending');
      return rs == 'pending' || rs == '' || rs == 'draft';
    }

    // Paid boost fields — only Cloud Functions (Admin SDK) may set/extend these.
    function promotionBoostFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'promotedUntil',
          'promotionPlanId',
          'promotionPaidAt',
          'promotionTxRef'
        ]);
    }

    function paidPromoStatuses() {
      return ['paid', 'active', 'fulfilled'];
    }

    function isPaidPromoStatus(s) {
      return s in paidPromoStatuses();
    }

    match /marketplace_items/{itemId} {
      allow read: if true;
      allow create: if isMarketplaceOwner(request.resource.data)
        && createReviewNotApproved()
        && !request.resource.data.keys().hasAny([
          'promotedUntil',
          'promotionPlanId',
          'promotionPaidAt',
          'promotionTxRef'
        ]);
      allow update: if isMarketplaceOwner(resource.data)
        && reviewStatusClientOk()
        && promotionBoostFieldsUntouched();
      allow delete: if isMarketplaceOwner(resource.data);
    }

    match /food_menu_items/{itemId} {
      allow read: if true;
      allow create: if isOwnerUid(request.resource.data)
        && createReviewNotApproved();
      allow update: if isOwnerUid(resource.data)
        && reviewStatusClientOk()
        && promotionBoostFieldsUntouched();
      allow delete: if isOwnerUid(resource.data);
    }

    match /accommodation_rooms/{itemId} {
      allow read: if true;
      allow create: if isOwnerUid(request.resource.data)
        && createReviewNotApproved();
      allow update: if isOwnerUid(resource.data)
        && reviewStatusClientOk()
        && promotionBoostFieldsUntouched();
      allow delete: if isOwnerUid(resource.data);
    }

    match /accommodations/{itemId} {
      allow read: if true;
      allow create: if isOwnerUid(request.resource.data)
        && createReviewNotApproved();
      allow update: if isOwnerUid(resource.data)
        && reviewStatusClientOk()
        && promotionBoostFieldsUntouched();
      allow delete: if isOwnerUid(resource.data);
    }

    match /merchant_stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.merchantId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.merchantId == request.auth.uid;

      match /viewers/{viewerId} {
        // Likes and the viewer list are for the story owner.
        // A viewer may read only their own row (so their heart stays filled).
        allow read: if isSignedIn() && (
          request.auth.uid == viewerId
          || get(/databases/$(database)/documents/merchant_stories/$(storyId)).data.merchantId
            == request.auth.uid
        );
        allow create, update: if isSignedIn()
          && request.auth.uid == viewerId;
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/merchant_stories/$(storyId)).data.merchantId
            == request.auth.uid;
      }
    }

    match /merchant_wallets/{merchantId} {
      allow read, write: if isSignedIn() && merchantId == request.auth.uid;
    }

    match /marketplace_merchants/{merchantId} {
      allow read: if true;
      allow write: if isSignedIn() && merchantId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && userId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read, create, update: if isSignedIn();
    }

    // Shared stay inventory — night counts are public so every guest sees "Booked".
    match /accommodation_occupancy/{accommodationId} {
      allow read: if true;
      allow create, update: if isSignedIn();

      match /nights/{dayId} {
        allow read: if true;
        allow create, update: if isSignedIn();
      }

      match /stays/{bookingRef} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
      }
    }

    // "X people added this to cart" — any signed-in buyer can bump unique counts.
    match /item_cart_stats/{itemId} {
      allow read: if true;
      allow create, update: if isSignedIn();

      match /adders/{uid} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Homepage paid adverts — public read; owner create/update (payment trust TBD).
    match /homepage_adverts/{advertId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'title', 'description', 'imageUrl', 'userId', 'status', 'txRef'
        ]);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Marketplace product promote (top boost + Facebook ad orders).
    // Paid/active only via Cloud Function activateMarketplacePromotion (Admin SDK).
    match /marketplace_promotions/{promoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.merchantId == request.auth.uid
        && request.resource.data.status == 'pending_payment';
      allow update: if isSignedIn()
        && resource.data.merchantId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['paymentVerifiedAt', 'paymentVerifiedBy'])
        && (
          (
            !isPaidPromoStatus(request.resource.data.status)
            && (
              request.resource.data.status == resource.data.status
              || request.resource.data.status in ['cancelled', 'failed', 'pending_payment']
            )
          )
          || (
            // After CF activation: merchant may only stamp platform-fee bookkeeping.
            isPaidPromoStatus(resource.data.status)
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'platformFeeCredited',
                'platformFeeAmount',
                'platformFeeMode',
                'platformFeeCreditedAt',
                'updatedAt'
              ])
          )
        );
    }

    // Free Nest-style promos (Postpromotion.dart) — owner only; must stamp merchantId.
    match /merchant_promotions/{promoId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.merchantId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.merchantId == request.auth.uid;
    }

    match /latest_arrivals/{arrivalId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.merchantId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.merchantId == request.auth.uid;
    }

    // Vero Coin / Points — owner only.
    match /vero_rewards/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // App-wide config (digital services, ride-share front desk, etc.).
    // Admin writes via Admin SDK / web panel.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Home search-bar crawl ticker (admin writes via Admin SDK / web panel).
    match /homepage_crawls/{crawlId} {
      allow read: if true;
      allow write: if false;
    }

    // Sell-on-Vero360 homepage banners (admin writes via web panel).
    match /sell_banners/{bannerId} {
      allow read: if true;
      allow write: if false;
    }

    // Shop gallery photos and videos. Public read; only the owner writes.
    match /shop_media/{mediaId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.merchantId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.merchantId == request.auth.uid;
    }

    // Reels: anyone (including guests) can watch. Owners create/delete their own.
    // Other signed-in users may only bump the engagement counters.
    // Reels LIVE. viewers/{uid} carries WebRTC signaling between host and viewer.
    match /lives/{liveId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'live';
      allow update: if isSignedIn() && (
        resource.data.hostId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
      );
      allow delete: if false;

      match /viewers/{uid} {
        allow read: if isSignedIn() && (
          request.auth.uid == uid
          || get(/databases/$(database)/documents/lives/$(liveId)).data.hostId == request.auth.uid
        );
        allow create, delete: if isSignedIn() && (
          request.auth.uid == uid
          || get(/databases/$(database)/documents/lives/$(liveId)).data.hostId == request.auth.uid
        );
        allow update: if isSignedIn() && (
          (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answer', 'viewerIce', 'session', 'name', 'photo', 'joinedAt']))
          || (get(/databases/$(database)/documents/lives/$(liveId)).data.hostId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['offer', 'hostIce']))
        );
      }

      match /chat/{messageId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200;
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/lives/$(liveId)).data.hostId == request.auth.uid;
      }
    }

    match /reels/{reelId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.hidden == false
        && request.resource.data.reportCount == 0;
      allow update: if isSignedIn() && (
        (
          resource.data.ownerId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerId', 'hidden', 'reportCount'])
        )
        || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likeCount', 'commentCount', 'viewCount', 'shareCount', 'reportCount'])
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
      }

      // One share per account (doc id = uid).
      match /shares/{uid} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        // Authors may blank their own comment; anyone may like/dislike or bump replies.
        allow update: if isSignedIn() && (
          (
            resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'text', 'likedBy', 'dislikedBy', 'replyCount'])
          )
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy', 'dislikedBy', 'replyCount'])
        );
        allow delete: if isSignedIn() && (
          resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/reels/$(reelId)).data.ownerId
            == request.auth.uid
        );
      }

      match /reports/{uid} {
        allow create, update: if isSignedIn() && request.auth.uid == uid;
        allow read: if false;
      }
    }

    // Admin → Vero360 Team chat broadcasts (everyone).
    match /vero_team_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Other app collections (chat, notifications, etc.) — signed-in users only.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
